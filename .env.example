# Claude Code uses its own authentication (claude login).
# The keys below are for demos that call AI APIs directly.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO

# Output directory for generated demos
DEMOS_OUTPUT_DIR=/tmp/demo-factory/demos

# Agent limits per demo
MAX_TURNS_PER_DEMO=25
MAX_BUDGET_USD=15.0
